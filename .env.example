# ==================================
# Data Enrich - Environment Variables
# ==================================

# Required API Keys
# -----------------

# Firecrawl API Key - Web scraping and content aggregation
# Get your key at: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# OpenAI API Key - AI-powered data extraction (GPT-4/GPT-5)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here


# Optional Configuration
# ----------------------

# Enable unlimited mode (removes row/column/field limits)
# Set to "true" for production deployments
# Default: automatically enabled in development
FIRE_ENRICH_UNLIMITED=true


# Rate Limiting (Optional - Recommended for Production)
# -----------------------------------------------------

# Upstash Redis for rate limiting
# Get your credentials at: https://upstash.com/
# Note: Rate limiting is automatically disabled in development without these
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here


# Advanced Configuration (Optional)
# ---------------------------------

# Node environment (usually set automatically)
# NODE_ENV=production

# Anthropic API Key (if using Claude models - currently unused)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here